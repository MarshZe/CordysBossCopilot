#!/usr/bin/env bash
# Cordys Boss Copilot CLI
# 只读老板专属经营命令行 — CEO/CFO/COO/CMO 高管顾问团
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SKILL_DIR="$(dirname "$SCRIPT_DIR")"
ENV_FILE="${SKILL_DIR}/.env"

if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

CORDYS_CRM_DOMAIN="${CORDYS_CRM_DOMAIN:-https://www.cordys.cn}"

die() { echo "错误: $*" >&2; exit 1; }

check_keys() {
  [[ -n "${CORDYS_ACCESS_KEY:-}" ]] || die "未设置 CORDYS_ACCESS_KEY"
  [[ -n "${CORDYS_SECRET_KEY:-}" ]] || die "未设置 CORDYS_SECRET_KEY"
}

# ─── 通用 Payload 生成 ───

page_payload() {
  local keyword="${1:-}"
  python3 - "$keyword" <<'PY'
import json, sys
keyword = sys.argv[1] if len(sys.argv) > 1 else ""
payload = {
  "current": 1,
  "pageSize": 30,
  "sort": {},
  "combineSearch": {"searchMode": "AND", "conditions": []},
  "keyword": keyword,
  "viewId": "ALL",
  "filters": []
}
print(json.dumps(payload, ensure_ascii=False))
PY
}

analysis_payload() {
  python3 - <<'PY'
import json
payload = {
  "granularity": "MONTH",
  "startTime": None,
  "endTime": None,
  "ownerIds": [],
  "departmentId": "",
  "platformValues": []
}
print(json.dumps(payload, ensure_ascii=False))
PY
}

target_payload() {
  python3 - <<'PY'
import json
payload = {
  "month": None,
  "departmentId": None
}
print(json.dumps(payload, ensure_ascii=False))
PY
}

home_stat_payload() {
  python3 - <<'PY'
import json
payload = {}
print(json.dumps(payload, ensure_ascii=False))
PY
}

# ─── HTTP 请求 ───

api_request() {
  local method="$1" path="$2"
  shift 2

  check_keys

  curl -s -X "$method" "${CORDYS_CRM_DOMAIN}${path}" \
    -H "X-Access-Key: ${CORDYS_ACCESS_KEY}" \
    -H "X-Secret-Key: ${CORDYS_SECRET_KEY}" \
    -H "Content-Type: application/json" \
    "$@"
}

# ─── analysis 命令族（经营看盘） ───

boss_analysis() {
  local report="$1"
  shift || true
  local first="${1:-}"
  local body

  if [[ -n "$first" && "$first" == \{* ]]; then
    body="$first"
  else
    body="$(analysis_payload)"
  fi

  case "$report" in
    customer-overview) api_request POST "/data-analysis/customer/overview" -d "$body" ;;
    customer-portrait) api_request POST "/data-analysis/customer/portrait" -d "$body" ;;
    order-overview) api_request POST "/data-analysis/order/overview" -d "$body" ;;
    order-cost) api_request POST "/data-analysis/order/cost" -d "$body" ;;
    *) die "未知的 analysis 子命令: $report（支持: customer-overview, customer-portrait, order-overview, order-cost）" ;;
  esac
}

# ─── sample-order 命令族（工单只读下钻） ───

boss_sample_order() {
  local action="$1"
  shift || true

  case "$action" in
    page)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(page_payload "${first:-}")"
      fi
      api_request POST "/sample-order/page" -d "$body"
      ;;
    get)
      local order_id="${1:-}"
      [[ -n "$order_id" ]] || die "sample-order get 需要工单 ID"
      api_request GET "/sample-order/get/${order_id}"
      ;;
    recovery-list)
      local order_id="${1:-}"
      [[ -n "$order_id" ]] || die "sample-order recovery-list 需要工单 ID"
      api_request GET "/sample-order/recovery/list/${order_id}"
      ;;
    pending-items)
      local order_id="${1:-}"
      [[ -n "$order_id" ]] || die "sample-order pending-items 需要工单 ID"
      api_request GET "/sample-order/recovery/pending-items/${order_id}"
      ;;
    *)
      die "只读模式下仅支持 sample-order page/get/recovery-list/pending-items"
      ;;
  esac
}

# ─── crm 命令族（核心模块只读） ───

boss_crm() {
  local action="$1"
  shift || true

  case "$action" in
    page)
      local module="${1:-}"
      [[ -n "$module" ]] || die "crm page 需要模块名（lead/account/opportunity/contract/contact）"
      shift || true
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(page_payload "${first:-}")"
      fi
      api_request POST "/${module}/page" -d "$body"
      ;;
    get)
      local module="${1:-}"
      [[ -n "$module" ]] || die "crm get 需要模块名"
      local record_id="${2:-}"
      [[ -n "$record_id" ]] || die "crm get 需要记录 ID"
      api_request GET "/${module}/${record_id}"
      ;;
    search)
      local module="${1:-}"
      [[ -n "$module" ]] || die "crm search 需要模块名"
      shift || true
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(page_payload "${first:-}")"
      fi
      api_request POST "/search/${module}" -d "$body"
      ;;
    contact)
      local module="${1:-}"
      [[ -n "$module" ]] || die "crm contact 需要模块名"
      local record_id="${2:-}"
      [[ -n "$record_id" ]] || die "crm contact 需要记录 ID"
      api_request GET "/${module}/contact/${record_id}"
      ;;
    follow)
      local type="${1:-}"
      [[ -n "$type" ]] || die "crm follow 需要类型（plan/record）"
      local module="${2:-}"
      [[ -n "$module" ]] || die "crm follow 需要模块名"
      shift 2 || true
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(page_payload "")"
      fi
      api_request POST "/${module}/follow/${type}/page" -d "$body"
      ;;
    product)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(page_payload "${first:-}")"
      fi
      api_request POST "/product/page" -d "$body"
      ;;
    org)
      api_request GET "/system/department/tree"
      ;;
    members)
      local first="${1:-}"
      [[ -n "$first" ]] || die "crm members 需要 JSON 参数（含 departmentId）"
      api_request POST "/system/user/list" -d "$first"
      ;;
    statistic)
      local module="${1:-}"
      [[ -n "$module" ]] || die "crm statistic 需要模块名（contract/payment-record/order）"
      shift || true
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(page_payload "${first:-}")"
      fi
      api_request POST "/${module}/statistic" -d "$body"
      ;;
    customer-stat)
      local stat_type="${1:-}"
      [[ -n "$stat_type" ]] || die "crm customer-stat 需要统计类型（contract/invoice/payment-plan/payment-record）"
      local account_id="${2:-}"
      [[ -n "$account_id" ]] || die "crm customer-stat 需要客户 ID"
      api_request GET "/customer/${stat_type}/statistic/${account_id}"
      ;;
    *)
      die "crm 子命令不支持: $action（支持: page, get, search, contact, follow, product, org, members, statistic, customer-stat）"
      ;;
  esac
}

# ─── target 命令族（商务目标管理） ───

boss_target() {
  local action="$1"
  shift || true

  case "$action" in
    home)
      api_request GET "/business-target/home"
      ;;
    my)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(target_payload)"
      fi
      api_request POST "/business-target/my" -d "$body"
      ;;
    team)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(target_payload)"
      fi
      api_request POST "/business-target/team" -d "$body"
      ;;
    ranking)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(target_payload)"
      fi
      api_request POST "/business-target/ranking" -d "$body"
      ;;
    history)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(target_payload)"
      fi
      api_request POST "/business-target/history" -d "$body"
      ;;
    level-options)
      api_request GET "/business-target/level-options"
      ;;
    *)
      die "target 子命令不支持: $action（支持: home, my, team, ranking, history, level-options）"
      ;;
  esac
}

# ─── home-stat 命令族（首页统计） ───

boss_home_stat() {
  local action="$1"
  shift || true

  case "$action" in
    lead)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(home_stat_payload)"
      fi
      api_request POST "/home/stat/lead" -d "$body"
      ;;
    opportunity)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(home_stat_payload)"
      fi
      api_request POST "/home/stat/opportunity" -d "$body"
      ;;
    opportunity-underway)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(home_stat_payload)"
      fi
      api_request POST "/home/stat/opportunity-underway" -d "$body"
      ;;
    opportunity-success)
      local first="${1:-}"
      local body
      if [[ -n "$first" && "$first" == \{* ]]; then
        body="$first"
      else
        body="$(home_stat_payload)"
      fi
      api_request POST "/home/stat/opportunity-success" -d "$body"
      ;;
    department-tree)
      api_request GET "/system/department/tree"
      ;;
    *)
      die "home-stat 子命令不支持: $action（支持: lead, opportunity, opportunity-underway, opportunity-success, department-tree）"
      ;;
  esac
}

# ─── 帮助信息 ───

usage() {
  cat <<'EOF'
cordys-boss — 老板专属只读经营 Copilot CLI（高管顾问团）

使用方法:
  cordys-boss <命令> [参数...]

命令族:

  📊 analysis — 经营数据分析（看盘）
    customer-overview [JSON]      达人经营概览
    customer-portrait [JSON]      达人画像（等级/平台/类型分布）
    order-overview [JSON]         工单经营概览
    order-cost [JSON]             工单成本分析

  📦 sample-order — 样品工单只读（风险下钻）
    page [keyword|JSON]           工单列表
    get <id>                      工单详情
    recovery-list <orderId>       回收流水
    pending-items <orderId>       待回收明细

  📋 crm — CRM 核心模块只读
    page <module> [keyword|JSON]  分页列表
    get <module> <id>             记录详情
    search <module> [keyword|JSON] 全局搜索
    contact <module> <id>         联系人列表
    follow <plan|record> <module> [JSON]  跟进计划/记录
    product [keyword|JSON]        产品列表
    org                           组织架构
    members <JSON>                部门成员

    支持模块: lead, account, opportunity, contract, contact
    二级模块: contract/payment-plan, contract/payment-record,
             contract/business-title, invoice, opportunity/quotation

    statistic <module> [JSON]      模块统计数据（contract/payment-record/order）
    customer-stat <type> <accountId>  客户维度统计（contract/invoice/payment-plan/payment-record）

  🎯 target — 商务目标管理
    home                          首页目标摘要
    my [JSON]                     我的目标
    team [JSON]                   团队目标看板
    ranking [JSON]                双榜排名
    history [JSON]                历史快照
    level-options                 层级选项

  🏠 home-stat — 首页统计
    lead [JSON]                   线索统计
    opportunity [JSON]            商机统计
    opportunity-underway [JSON]   进行中商机统计
    opportunity-success [JSON]    赢单商机统计
    department-tree               部门权限树

  help                            显示帮助

示例:
  cordys-boss analysis customer-overview
  cordys-boss analysis order-cost '{"granularity":"WEEK"}'
  cordys-boss sample-order page "张语恒"
  cordys-boss crm page contract '{"combineSearch":{"searchMode":"OR","conditions":[{"value":"WEEK","operator":"DYNAMICS","name":"startTime","multipleValue":false,"type":"TIME_RANGE_PICKER"},{"value":"WEEK","operator":"DYNAMICS","name":"endTime","multipleValue":false,"type":"TIME_RANGE_PICKER"}]}}'
  cordys-boss crm get account 123456
  cordys-boss target home
  cordys-boss target ranking
  cordys-boss crm statistic contract
  cordys-boss crm customer-stat contract 123456
  cordys-boss home-stat lead

安全边界:
  - 本 CLI 只读，不支持任何写操作
  - 不提供 raw 模式
  - 合同金额 = GMV（已筛除退款），财务核算关注合同金额即可
  - 样品单价 = 日常售卖价，用于成本预估
EOF
}

# ─── 主路由 ───

cmd="${1:-help}"
shift || true

case "$cmd" in
  analysis)     boss_analysis "$@" ;;
  sample-order) boss_sample_order "$@" ;;
  crm)          boss_crm "$@" ;;
  target)       boss_target "$@" ;;
  home-stat)    boss_home_stat "$@" ;;
  help|-h|--help) usage ;;
  *)
    die "未知命令: $cmd（尝试 cordys-boss help）"
    ;;
esac
